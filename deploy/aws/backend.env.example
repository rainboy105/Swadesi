# Copy to /etc/swadesi/backend.env on the EC2 box. Never commit real values.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Supabase Postgres (use the Session pooler / IPv4 connection string from the Supabase dashboard)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=
DB_POOL_MAX=10

# App JWT
APP_JWT_SECRET=

# CORS — the live site origin(s), comma separated
CORS_ALLOWED_ORIGINS=https://example.com

# Web Push (VAPID). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@swaadesi.org
